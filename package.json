{
    "name": "frontend-foundation",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "next dev --port 5000",
        "build": "next build && npm run registry:build && storybook build -o storybook-static && rimraf public/stories && cp -r storybook-static public/stories",
        "start": "next start",
        "analyze": "ANALYZE=true next build",
        "registry:build": "node scripts/generate-registry.mjs",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "gen:component": "plop component",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "icons:clean": "rimraf src/components/Icons",
        "icons:generate": "npm run icons:clean && svgr --no-prettier --icon --typescript --filename-case kebab --jsx-runtime automatic --svg-props width=20,height=20 --replace-attr-values \"#000=currentColor,#fff=currentColor\" --out-dir src/components/_icons public/icons",
        "test": "vitest --project unit",
        "test:watch": "vitest --project unit --watch",
        "test:coverage": "vitest --project unit --coverage",
        "test:a11y": "vitest --project storybook",
        "test:e2e": "playwright test",
        "chromatic": "dotenv -e .env.local -- npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
        "prepare": "husky"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@hookform/resolvers": "^5.4.0",
        "@sentry/nextjs": "^10.70.0",
        "@tanstack/query-async-storage-persister": "^5.101.0",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-query-persist-client": "^5.101.0",
        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.18.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.17.0",
        "motion": "^12.40.0",
        "next": "16.2.6",
        "next-themes": "^0.4.6",
        "nextjs-toploader": "^3.9.17",
        "radix-ui": "^1.4.3",
        "react": "19.2.4",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.4",
        "react-error-boundary": "^6.1.2",
        "react-hook-form": "^7.79.0",
        "react-resizable-panels": "^4.12.1",
        "react-scan": "^0.5.7",
        "shadcn": "^4.12.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "universal-cookie": "^8.1.2",
        "vaul": "^1.1.2",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.3.1",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@next/bundle-analyzer": "^16.3.5",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-a11y": "^10.6.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-themes": "^10.6.0",
        "@storybook/addon-vitest": "^10.6.0",
        "@storybook/nextjs-vite": "^10.6.0",
        "@svgr/cli": "^8.1.0",
        "@tailwindcss/postcss": "^4",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/browser-playwright": "^5.0.0",
        "@vitest/coverage-v8": "^5.0.0",
        "chromatic": "^18.8.1",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.10.0",
        "eslint-config-next": "16.3.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-storybook": "^10.6.0",
        "eslint-plugin-tailwindcss": "^4.4.0",
        "eslint-plugin-unicorn": "^74.0.0",
        "happy-dom": "^20.14.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "msw": "^2.15.0",
        "playwright": "^1.60.0",
        "plop": "^4.0.5",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rimraf": "^6.1.3",
        "storybook": "^10.4.2",
        "storybook-addon-grid": "^0.7.1",
        "storybook-addon-pseudo-states": "^10.6.0",
        "storybook-dark-mode": "^5.0.0",
        "tailwindcss": "^4",
        "typescript": "^7",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
